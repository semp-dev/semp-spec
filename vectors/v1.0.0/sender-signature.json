    {
      "id": "sender-signature-tampered-body",
      "description": "Take the §17.2/sender-signature-valid output and change one byte of the body text/plain. The reconstructed canonical bytes differ from what was signed, so Ed25519 verify MUST reject.",
      "spec_reference": "VECTORS.md §17.2; ENVELOPE.md §6.5.3",
      "inputs": {
        "identity_public_key_hex": "d04ab232742bb4ab3a1368bd4615e4e6d0224ab71a016baf8520a332c9778737",
        "tampered_signed_enclosure_json": {
