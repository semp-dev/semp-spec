          "sender_signature": {
            "algorithm": "ed25519",
            "key_id": "10ba682c8ad13513971e8b56881aab8bd702bb807796eca81932c735a94d6e6d",
            "value": "PivuJsuYrMqIYcmS9PcSsD3k8m374i+39Hosnafg6kfT3UHOCszZ4L0wEnVA0cOIvZZut8Rp4gfa6gKe8Js9CQ=="
