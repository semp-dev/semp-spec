        "identity_key_id": "10ba682c8ad13513971e8b56881aab8bd702bb807796eca81932c735a94d6e6d",
        "enclosure_pre_sign_json": {
          "subject": "Layer 3 vector check",
          "content_type": "text/plain",
          "body": {
            "text/plain": "VGhlIHF1aWNrIGJyb3duIGZveCBqdW1wcyBvdmVyIHRoZSBsYXp5IGRvZy4="
          },
          "attachments": [],
          "forwarded_from": null,
