        "claimed_identity_public_key_hex": "d04ab232742bb4ab3a1368bd4615e4e6d0224ab71a016baf8520a332c9778737",
        "actual_signer_private_seed_hex": "2222222222222222222222222222222222222222222222222222222222222222",
        "actual_signer_public_key_hex": "a09aa5f47a6759802ff955f8dc2d2a14a5c99d23be97f864127ff9383455a4f0",
        "signed_enclosure_json": {
          "subject": "Layer 3 vector check",
          "content_type": "text/plain",
