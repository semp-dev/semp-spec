          "server_nonce": "u7u7u7u7u7u7u7u7u7u7u7u7u7u7u7u7u7u7u7u7u7s=",
          "server_ephemeral_key": {
            "algorithm": "x25519-chacha20-poly1305",
            "key": "c2VydmVyLWVwaGVtZXJhbC1rZXk=",
